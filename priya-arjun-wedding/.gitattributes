# Store every text file with LF so the repo does not change shape between
# machines, and a Windows checkout does not show whole files as rewritten.
* text=auto eol=lf

# Leave binaries alone.
*.woff2 binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.mp4   binary
*.zip   binary
