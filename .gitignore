# Guest media uploaded through the editor. User content, often large, and
# recreated per deployment — not source.
uploads/

# Admin password hash. Must never leave this machine.
data/admin-auth.json

# Guest RSVP replies. Personal data, and runtime state rather than source.
# The server falls back to an empty list when the file is absent.
data/rsvps.json

# data/config.json IS tracked on purpose: Netlify seeds its blob store from it
# on first run (netlify/functions/_shared.mjs → readBundledConfig).

# Release archives — git replaces these
*.zip

# Netlify CLI
.netlify/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
